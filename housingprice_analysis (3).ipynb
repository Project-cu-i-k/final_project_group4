    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "\n",
    "features = ['Province_encoded','District_encoded', 'Frontage', 'Access Road',\n",
    "            'Bedrooms', 'Bathrooms', 'Price',\n",
    "            'House_direction_sin', 'House_direction_cos',\n",
    "            'Balcony_direction_sin', 'Balcony_direction_cos']\n",
    "\n",
    "clusters = sorted(X_plot['Label'].unique())\n",
    "\n",
    "# Tính correlation cho từng cluster và ghép lại\n",
    "corr_blocks = []\n",
    "for c in clusters:\n",
    "    corr = X_plot[X_plot['Label'] == c][features].corr()\n",
    "    corr.index = [f\"{idx} (C{c})\" for idx in corr.index]   # ghi nhãn cluster vào chỉ mục\n",
    "    corr_blocks.append(corr)\n",
    "\n",
    "# Ghép dọc tất cả các ma trận tương quan\n",
    "corr_all = pd.concat(corr_blocks, axis=0)\n",
    "\n",
    "plt.figure(figsize=(14, 10))\n",
    "sns.heatmap(\n",
    "    corr_all, \n",
    "    annot=False,\n",
    "    cmap='YlGnBu',\n",
    "    linewidths=0.3,\n",
    "    cbar_kws={'shrink': 0.5}\n",
    ")\n",
    "\n",
    "plt.title(\"Correlation Heatmap – Tất cả 5 Cluster\", fontsize=15, pad=15)\n",
    "plt.xticks(rotation=30, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
