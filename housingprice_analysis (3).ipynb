    "plt.title('Phân cụm DBSCAN (giảm chiều bằng PCA)')\n",
    "plt.xlabel('Thành phần chính 1')\n",
    "plt.ylabel('Thành phần chính 2')\n",
    "plt.colorbar(label='Cụm DBSCAN')\n",
    "plt.show()"
   ]
